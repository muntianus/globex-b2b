# globex-b2b — copy to .env; every variable is optional.
PORT=4010

# JSON file for catalog/order persistence. Empty = in-memory only.
GLOBEX_STORE_PATH=

# Upstream Globex API probed by GET /api/v1/sync/globlex.
GLOBEX_UPSTREAM_URL=https://api.globlex.pro

# Upstream probe timeout.
GLOBEX_BRIDGE_TIMEOUT_MS=2500

# 1 = never call upstream; /sync/globlex returns the deterministic fallback.
GLOBEX_OFFLINE_FALLBACK=0
